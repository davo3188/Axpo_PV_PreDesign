  "owner": "Design ESQ team (Urbasolar) - to be confirmed",
  "notes": "Transcribed from the Design ESQ toolkit sheets. Every value carries its source; 'verify: true' marks values read from text extraction that still need a check on the DWG. Structure presets only fix module counts, gaps and defaults: table sizes are computed from the chosen module, pitch is always set by the user (the tool suggests the toolkit minimum).",
  "sources": {
    "CS": "Toolkit_FR/DESIGN/TOOLKIT_ESQ-CS_V2.pdf (ground-mounted, fixed)",
    "AGRI": "Toolkit_FR/DESIGN/TOOLKIT_ESQ-AGRI PV_V4.pdf (agrivoltaics)",
    "NORMES": "Toolkit_FR/DESIGN/TOOLKIT_ESQ-NORMES_V2.pdf (design doctrine)",
    "PC": "Toolkit_FR/DESIGN/TOOLKIT_ESQ-PERMIS DE CONSTRUIRE_V5.pdf (building permit details)"
  },

  "defaults": {
    "moduleGap": { "value": 0.02, "unit": "m", "source": "CS", "note": "Reproduces every CS table length: n*W + (n-1)*0.02 (2V13 14.98, 3V9 10.37, 3V18 20.75 with W = 1.134)" },
    "tableGap": { "value": 0.30, "unit": "m", "source": "CS", "note": "gap between consecutive tables along a row" },
    "fixed": {
      "tiltDeg": { "value": 15, "source": "CS" },
      "azimuthDeg": { "value": 180, "source": "CS", "note": "facing south" },
      "lowEdgeHeight": { "value": 1.1, "unit": "m", "source": "CS" },
      "maxShadingAngleDeg": { "value": 35, "source": "CS", "note": "Angle d'ombrage maximal de 35 deg: minimum pitch = D*cos(tilt) + D*sin(tilt)/tan(35 deg). Checked on the 3V9 section: 6.94 + 2.66 = 9.60 m" }
    },
    "transversalTrack": {
      "spacing": { "value": 100, "unit": "m", "source": "CS, AGRI, NORMES", "note": "Piste transversale tous les 100 m (Est/Ouest)" },
      "width": { "value": 4, "unit": "m", "verify": true, "note": "width not found in the extracted text - to confirm" }
    }
  },

