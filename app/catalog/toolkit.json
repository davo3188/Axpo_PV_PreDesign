  "rules": [
    { "id": "max-shading-angle", "applies": ["ground-fixed"], "value": 35, "unit": "deg", "source": "CS", "text": "Angle d'ombrage maximal de 35 deg" },
    { "id": "transversal-track", "applies": ["ground-fixed", "agri-fixed", "agri-tracker"], "spacing": 100, "unit": "m", "source": "CS, AGRI, NORMES", "text": "Piste transversale tous les 100 m (Est/Ouest)" },
    { "id": "agri-max-coverage", "applies": ["agri-fixed", "agri-tracker"], "value": 0.40, "source": "AGRI", "text": "40% de couverture PV maximum" },
    { "id": "agri-crop-slope", "applies": ["agri-fixed"], "value": 5, "max": 6, "unit": "%", "source": "AGRI", "text": "Ombrieres de culture: 5% (max 6% with extra cost), in one direction only" },
    { "id": "tracker-2v-azimuth", "applies": ["agri-tracker"], "value": 30, "unit": "deg", "source": "AGRI", "text": "Tracker 2V: at most +30 deg (south = 0) towards east or west" },
    { "id": "canopy-expansion-joint", "applies": ["agri-fixed"], "value": 0.30, "every": 100, "unit": "m", "source": "AGRI", "text": "30 cm expansion joint for canopies longer than 100 m, repeated every 100 m" },
    { "id": "fire-tank-near-entrance", "applies": ["all"], "maxDistance": 50, "unit": "m", "source": "NORMES", "text": "Fire water tank always close to the entrance and a track (max 50 m)" },
    { "id": "delivery-station-at-entrance", "applies": ["all"], "source": "NORMES", "text": "Delivery station (PDL) as close as possible to the grid connection, at the entrance, flush with the fence (DSO access)" },
    { "id": "transformer-stations-by-power", "applies": ["all"], "source": "NORMES", "text": "Split the project power over transformer stations (PDT). Example: 6 MWp = 2 PDT, units of 4 MWp and 2.5 MWp" },
    { "id": "avoid-grid-lines", "applies": ["all"], "source": "NORMES", "text": "Avoid overhead power lines and underground grid" },
    { "id": "overhead-line-clearance", "applies": ["all"], "source": "NORMES", "text": "Overhead line: > 3 m if HTB, > 5 m if HTA", "verify": true }
  ],

